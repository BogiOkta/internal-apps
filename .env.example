# Existing internal PostgreSQL server and migration runner
DB_HOST=your-host
DB_PORT=5432
DB_NAME=internal_apps
DB_OWNER_USER=internal_apps_owner
DB_OWNER_PASSWORD=change_me_locally
DB_SSL_MODE=Require
DB_TRUST_SERVER_CERTIFICATE=true

APP_DB_USER=internal_apps_app
APP_DB_PASSWORD=change_me_later
ADMIN_INITIAL_PASSWORD=change_me_before_migration

# JWT authentication
JWT_ISSUER=InternalApps.Api
JWT_AUDIENCE=InternalApps.Portal
JWT_SIGNING_KEY=replace_with_at_least_32_random_characters
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# Optional local Docker PostgreSQL only
POSTGRES_DB=internal_apps
POSTGRES_USER=internal_apps_owner
POSTGRES_PASSWORD=change_me_locally

# Local application URLs
PORTAL_URL=http://localhost:3000
API_BASE_URL=http://localhost:5000
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Controlled local smoke identities (never commit real values)
SMOKE_ADMIN_USERNAME=replace_locally
SMOKE_ADMIN_PASSWORD=replace_locally
SMOKE_BASIC_USERNAME=smoke_basic_user
SMOKE_BASIC_PASSWORD=replace_locally_with_at_least_12_characters
SMOKE_BASIC_DISPLAY_NAME=Smoke Basic User

# Sprint 05C controlled Vacation API smoke
# Dates must be an unused same-year range containing a weekday. The linked
# smoke employee needs sufficient balance for one active balance-backed type.
SMOKE_VACATION_DATE_FROM=2026-08-10
SMOKE_VACATION_DATE_TO=2026-08-14
# Optional safe fixtures; leave blank to skip their isolated checks.
SMOKE_UNLINKED_USERNAME=
SMOKE_UNLINKED_PASSWORD=
SMOKE_OTHER_LINKED_USERNAME=
SMOKE_OTHER_LINKED_PASSWORD=
